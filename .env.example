# Copy to .env and adjust. Never commit the real .env.

# --- Postgres ---------------------------------------------------------------
DB_HOST=127.0.0.1
# 5433, not 5432 — see docker-compose.yml. Avoids colliding with a Postgres
# installed natively on the host.
DB_PORT=5433
DB_NAME=actioncloud
DB_USER=actioncloud
DB_PASSWORD=actioncloud

# --- Queue ------------------------------------------------------------------
AWS_REGION=us-east-1
QUEUE_NAME=actioncloud-experiences

# Point at LocalStack for local dev. DELETE this line when running on real AWS
# so boto3 resolves the genuine SQS endpoint.
AWS_ENDPOINT_URL=http://localhost:4566

# LocalStack ignores these but boto3 refuses to start without something set.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Behaviour --------------------------------------------------------------
EMBEDDING_DIM=1536

# Bypass the queue and write straight to Postgres. Tests only — enabling this
# during the experiment would distort the latency you are trying to measure.
SYNC_WRITE=false
